# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored — never commit real credentials.
# Every variable below is optional except AQM_SERIAL_PORT: if BLYNK_AUTH_TOKEN
# or OPENAI_API_KEY are left blank, that feature is simply disabled at runtime.

# Serial port the sensor node (Arduino) is connected to.
AQM_SERIAL_PORT=COM3
AQM_BAUD_RATE=115200

# Optional: Blynk cloud dashboard auth token. Leave blank to disable upload.
BLYNK_AUTH_TOKEN=
AQM_BLYNK_INTERVAL_S=5

# Optional: OpenAI API key for plain-language environmental summaries.
# Leave blank to disable AI analysis.
OPENAI_API_KEY=
AQM_OPENAI_MODEL=gpt-4o-mini
AQM_ANALYSIS_INTERVAL_S=300
